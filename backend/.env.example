# Server
PORT=8000
NODE_ENV=production

# JWT
JWT_SECRET=your-strong-random-jwt-secret-here

# Database (Neon / Supabase / any Postgres)
# Use the pooled URL for runtime queries
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Use the unpooled URL for Drizzle migrations (drizzle-kit push)
DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require

# CORS — comma-separated list of allowed frontend origins (no trailing slash)
# Example: https://your-frontend.vercel.app,http://localhost:5173
CORS_ORIGIN=https://your-frontend.vercel.app

# Email Configuration (Resend)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=Your Name <onboarding@resend.dev>

